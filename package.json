{
  "name": "blacktec-mafia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BlackTec Mafia — noir social deduction board game for the browser (solo vs bots + online rooms by link)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "discovery": "node server/discovery.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
